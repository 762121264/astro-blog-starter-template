---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const allTags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
			.search-bar {
				margin-bottom: 1.5em;
			}
			.search-bar input {
				width: 100%;
				font-family: inherit;
				font-size: 1em;
				padding: 0.6em 0.8em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 999px;
				color: rgb(var(--gray-dark));
				outline: none;
				box-sizing: border-box;
				transition: 0.15s ease;
			}
			.search-bar input::placeholder {
				color: rgb(var(--gray));
			}
			.search-bar input:focus {
				border-color: var(--accent);
			}
			.filter-bar {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em;
				margin-bottom: 2em;
			}
			.filter-bar button {
				font-family: inherit;
				font-size: 0.9em;
				padding: 0.4em 0.9em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 999px;
				background: white;
				color: rgb(var(--gray-dark));
				cursor: pointer;
				white-space: nowrap;
				transition: 0.15s ease;
			}
			.filter-bar button:hover {
				border-color: var(--accent);
				color: var(--accent);
			}
			.filter-bar button.active {
				background: var(--accent);
				border-color: var(--accent);
				color: white;
			}
			.post-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4em;
				margin-top: 0.5em;
			}
			.post-tags .tag {
				font-size: 0.75em;
				padding: 0.15em 0.6em;
				border-radius: 999px;
				background: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
				white-space: nowrap;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li:first-child {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}
			ul li:first-child img {
				width: 100%;
			}
			ul li:first-child .title {
				font-size: 2.369rem;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			.no-results {
				text-align: center;
				color: rgb(var(--gray));
				padding: 2em;
			}
			@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
				ul li:first-child {
					margin-bottom: 0;
				}
				ul li:first-child .title {
					font-size: 1.563em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<div class="search-bar">
					<input
						type="search"
						id="post-search"
						placeholder="Search posts..."
						autocomplete="off"
					/>
				</div>
				<div class="filter-bar" id="filter-bar">
					<button class="active" data-tag="all">All</button>
					{allTags.map((tag) => (
						<button data-tag={tag}>{tag}</button>
					))}
				</div>
				<ul id="post-list">
					{
						posts.map((post) => (
							<li data-tags={post.data.tags.join(',')} data-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(' ')}`.toLowerCase()}>
								<a href={`/blog/${post.id}/`}>
									<img width={720} height={360} src={post.data.heroImage} alt="" />
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
									{post.data.tags.length > 0 && (
										<div class="post-tags">
											{post.data.tags.map((tag) => (
												<span class="tag">{tag}</span>
											))}
										</div>
									)}
								</a>
							</li>
						))
					}
				</ul>
				<p class="no-results" id="no-results" style="display:none;">
					No posts found for this category.
				</p>
			</section>
		</main>
		<Footer />
		<script>
			const buttons = document.querySelectorAll('#filter-bar button');
			const posts = document.querySelectorAll('#post-list li');
			const noResults = document.getElementById('no-results');
			const searchInput = document.getElementById('post-search');

			let activeTag = 'all';

			function applyFilter() {
				const query = (searchInput.value || '').trim().toLowerCase();
				buttons.forEach((b) =>
					b.classList.toggle('active', b.dataset.tag === activeTag)
				);
				let visibleCount = 0;
				posts.forEach((post) => {
					const tags = (post.dataset.tags || '').split(',');
					const tagMatch = activeTag === 'all' || tags.includes(activeTag);
					const searchMatch =
						query === '' || (post.dataset.search || '').includes(query);
					const show = tagMatch && searchMatch;
					post.style.display = show ? '' : 'none';
					if (show) visibleCount++;
				});
				noResults.style.display = visibleCount === 0 ? '' : 'none';
			}

			buttons.forEach((btn) => {
				btn.addEventListener('click', () => {
					activeTag = btn.dataset.tag;
					applyFilter();
				});
			});

			searchInput.addEventListener('input', () => applyFilter());

			const params = new URLSearchParams(window.location.search);
			const initialTag = params.get('tag');
			if (initialTag) {
				activeTag = initialTag;
				applyFilter();
			}
		</script>
	</body>
</html>
